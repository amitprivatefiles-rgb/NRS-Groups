# --- Lead storage -----------------------------------------------------------
# Postgres connection string (Neon, Supabase, Vercel Postgres, RDS ...).
# If unset, leads are written to ./data/leads.json (local development only).
DATABASE_URL=

# --- Lead notification email -------------------------------------------------
# Where "New investor / creator enquiry from NRS website" emails are sent.
LEAD_NOTIFY_TO=info@nrsgroups.in
LEAD_NOTIFY_FROM="NRS Group Website <no-reply@nrsgroups.in>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Admin lead list (/admin) -----------------------------------------------
ADMIN_PASSWORD=change-me
# Random string used to sign the admin session cookie.
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
